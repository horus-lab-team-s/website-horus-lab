# Racine du monorepo — voir frontend/.gitignore et backend/.gitignore
# pour les règles spécifiques.

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python (sécurité, au cas où)
__pycache__/
*.py[cod]
.venv/
venv/

# Variables docker-compose (contiennent des secrets)
.env

# Etat local de l'agent Claude Code (ne pas versionner)
.claude/

# Captures d'ecran de consoles d'administration (Brevo, VPS, DNS...) : elles
# exposent des IP de serveur, des identifiants ou des cles. Le depot est PUBLIC.
docs/*.png
docs/*.jpg
docs/*.jpeg
# Exception : schemas/diagrammes produits pour la documentation. Aucun secret,
# aucune IP, aucun identifiant -> versionnables sur un depot public.
!docs/carte-mentale-horus-lab.png
